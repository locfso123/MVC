@model IEnumerable<mvc01.Models.Blog.Post>

@{
    ViewData["Title"] = "Danh sach Blog";
}

<h1>@ViewData["Title"]</h1>

<partial name = "_AlertMessage"></partial>

<p>
    <a asp-action="Create" class="btn btn-primary btn-sm">Tạo bài viết mới</a>
</p>

<p>Tong so bai viet: @ViewBag.totalPosts</p>

<table class="table">
    <thead>
        <tr>
            <th>STT</th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Published)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Author)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateCreated)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateUpdated)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(++ViewBag.postInPage)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.PostId">@Html.DisplayFor(modelItem => item.Title)</a>
                    <br />
                    <small>
                            @string.Join(", ", item.PostCategories.Select(pc => pc.Category.Title));
                    </small>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Published)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Author.UserName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DateCreated)
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.PostId">Chi tiết</a>
                    |
                    <a asp-action="Delete" asp-route-id="@item.PostId">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>

