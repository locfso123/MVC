@model mvc._01.Models.PlanetModel

<h1>@Model.Name</h1>

<div class="card w-50">
    <img class="card-img-top" src="~/planet/@(Model.Name).jpg" />
    <div class="card-body">
        <h5>@Model.VnName</h5>
        <div class="card-text">
            @Model.Content
        </div>

        <a class="card-link" asp-action="Index"></a>

    </div>
</div>
