@page
@model mvc01.Pages.CategoryPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Category[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category[0].Slug)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category[0].CategoryChildren)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category[0].ParentCategoryId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category[0].ParentCategory)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Category) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                @Html.DisplayFor(model => item.Slug)
            </td>
            <td>
                @Html.DisplayFor(model => item.CategoryChildren)
            </td>
            <td>
                @Html.DisplayFor(model => item.ParentCategoryId)
            </td>
            <td>
                @Html.DisplayFor(model => item.ParentCategory)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
